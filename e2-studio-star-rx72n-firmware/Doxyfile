GENERATE_MAN            = NO
GENERATE_XML            = NO
GENERATE_DOCBOOK        = NO
GENERATE_AUTOGEN_DEF    = NO
GENERATE_PERLMOD        = NO

#---------------------------------------------------------------------------
# Preprocessor - handle RX72N/GNURX conditionals
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = NO
SEARCH_INCLUDES         = YES
INCLUDE_PATH            = src/inc \
                          src/boot/inc \
                          src/boot/smc_generated \
                          libs/rx_core/inc \
                          libs/rx_hal/inc \
                          libs/rx_pid/inc \
                          libs/rx_motor/inc \
                          libs/rx_encoder/inc \
                          libs/rx_bus/inc \
                          libs/rx_crc/inc \
                          libs/rx_fec/inc \
                          libs/rx_harq/inc \
                          libs/rx_frame/inc \
                          libs/rx_frame_ascii/inc \
                          libs/rx_comm_manager/inc \
                          libs/rx_session/inc \
                          libs/rx_spi_comm/inc \
                          libs/rx_spi_link/inc \
                          libs/rx_usb/inc \
                          libs/rx_usb_comm/inc \
                          libs/rx_drv8243/inc \
                          libs/rx_ds18b20/inc \
                          libs/rx_bq4050/inc \
                          libs/rx_hcsr04/inc \
                          libs/rx_obstacle_detect/inc
INCLUDE_FILE_PATTERNS   =
PREDEFINED              = __RX__ \
                          __GNURX__ \
                          __attribute__(x)= \
                          __inline__=inline \
                          __volatile__=volatile \
                          DOXYGEN_ONLY
EXPAND_AS_DEFINED       =
SKIP_FUNCTION_MACROS    = YES

