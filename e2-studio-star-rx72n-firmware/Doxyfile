HIDE_IN_BODY_DOCS       = NO
INTERNAL_DOCS           = YES
CASE_SENSE_NAMES        = NO
HIDE_SCOPE_NAMES        = NO
HIDE_COMPOUND_REFERENCE = NO
SHOW_HEADERFILE         = YES
