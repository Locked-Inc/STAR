# Doxyfile for STAR RX72N Firmware
# Run from: e2-studio-star-rx72n-firmware/
# Usage:
#   doxygen Doxyfile          -- generate HTML + LaTeX
#   make -C docs/doxygen/latex -- compile LaTeX to PDF (refman.pdf)
#
# Output:
#   docs/doxygen/html/index.html -- browsable HTML reference
#   docs/doxygen/latex/refman.pdf -- printable API reference

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------
PROJECT_NAME            = "STAR RX72N Firmware"
PROJECT_NUMBER          = "1.0.0"
PROJECT_BRIEF           = "Renesas RX72N motor controller firmware - ThreadX RTOS"
PROJECT_LOGO            =
OUTPUT_DIRECTORY        = docs/doxygen
CREATE_SUBDIRS          = NO
OUTPUT_LANGUAGE         = English
BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = YES
ABBREVIATE_BRIEF        = "The $name class" \
                          "The $name widget" \
                          "The $name file" \
                          is \
                          provides \
                          specifies \
                          contains \
                          represents \
                          a \
                          an \
                          the
