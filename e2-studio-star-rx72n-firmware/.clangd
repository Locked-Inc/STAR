CompileFlags:
  CompilationDatabase: build/
  Add:
    - -I/opt/gnurx/rx-elf/rx-elf/include
    - -I../src

Index:
  Background: Build
  StandardLibrary: No

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

---
# Generated nanopb code is tool-owned; suppress include-cleaner noise.
If:
  PathMatch: libs/rx_nanopb/inc/gen/.*\.(c|h)
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
