# motor_control.options - nanopb field size constraints for motor_control.proto
# These settings optimize for ESP32 embedded use with static allocation.
#
# STAR Project - Texas A&M University

# Emergency stop reason
star.v1.EmergencyStopRequest.reason     max_size:128

# Motor status array (2 motors for differential drive)
star.v1.SetVelocityResponse.motor_status    max_count:2
