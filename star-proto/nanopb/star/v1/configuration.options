# configuration.options - nanopb field size constraints for configuration.proto
# These settings optimize for RX72N embedded use with static allocation.
#
# STAR Project - Texas A&M University

# Configuration validation error details
star.v1.ConfigValidationError.field_path            max_size:128
star.v1.ConfigValidationError.message               max_size:256
star.v1.ConfigValidationError.actual_value           max_size:64
star.v1.ConfigValidationError.expected_constraint    max_size:128

# Validation result error list (max 8 validation errors)
star.v1.ConfigValidationResult.errors               max_count:8

# Motor configs array (max 4 motors)
star.v1.SystemConfiguration.motor_configs           max_count:4

# RetransmitConfig: all scalar fields, no constraints needed
