{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {}
        },
        {
            "name": "cross-debug",
            "inherits": "default",
            "toolchainFile": "${sourceDir}/toolchain-arm-linux-gnueabihf.cmake",
            "binaryDir": "${sourceDir}/build-cross-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "cross-release",
            "inherits": "default",
            "toolchainFile": "${sourceDir}/toolchain-arm-linux-gnueabihf.cmake",
            "binaryDir": "${sourceDir}/build-cross-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "native-debug",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-native-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "native-release",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-native-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cross-debug",
            "configurePreset": "cross-debug"
        },
        {
            "name": "cross-release",
            "configurePreset": "cross-release"
        },
        {
            "name": "native-debug",
            "configurePreset": "native-debug"
        },
        {
            "name": "native-release",
            "configurePreset": "native-release"
        }
    ]
}
