[Unit]
Description=STAR cockpit HTTP API (Grafana toggle/speed backend)
After=network-online.target

[Service]
User=star
Group=star
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /workspaces/STAR/star-ros2/install/setup.bash && export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && export CYCLONEDDS_URI=file:///workspaces/STAR/config/cyclonedds.xml && exec python3 /opt/star_cockpit_api/server.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
