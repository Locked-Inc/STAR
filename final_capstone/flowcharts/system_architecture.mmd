flowchart LR
    subgraph pi5 ["Raspberry Pi 5  (ROS2 Jazzy)"]
        direction TB
        slam["slam_toolbox async<br/>/map at 0.5 Hz"]
        ekf["robot_localization EKF<br/>/odom"]
        nav2["Nav2<br/>NavFn A* + DWB"]
        explore["m-explore-ros2<br/>frontier exploration"]
        compliance["ADA compliance engine<br/>Python + Open3D + OpenCV"]
        gateway["Go gateway<br/>gRPC-Web + WebSocket"]
        ui["React 19.2 UI<br/>20 panels"]
    end

    subgraph rx72n ["Custom RX72N PCB  (ThreadX RTOS, C23)"]
        direction TB
        comm["comm_task<br/>HARQ + FEC + nanopb"]
        motor["motor_control_task<br/>250 Hz PID"]
        imu_rx["imu_task<br/>BNO055 I2C"]
        tele["telemetry_task<br/>HC-SR04, DS18B20, BMP280"]
        obstacle["obstacle_detect_task<br/>4x HC-SR04"]
        wd["watchdog_monitor_task"]
    end

    lidar[(RPLiDAR C1<br/>360, 10 Hz, 12 m)]
    stereo[(IMX219-83 stereo<br/>2x IMX219 8 MP, 60 mm)]
    icm[(ICM20948 IMU<br/>on camera board)]
    bno[(BNO055 IMU<br/>on chassis)]
    sonar[(4x HC-SR04<br/>ultrasonic)]
    ds[(DS18B20<br/>temperature)]
    bmp[(BMP280<br/>pressure)]

    motors[(4x DFRobot FIT0520<br/>4x DRV8263H)]

    browser([Operator / judge<br/>browser])

    lidar -- USB --> pi5
    stereo -- "dual MIPI CSI-2" --> pi5
    icm -- I2C --> pi5

    bno -- "I2C (RIIC1)" --> imu_rx
    sonar -- "GPIO trigger / IRQ" --> obstacle
    ds -- "1-Wire P51" --> tele
    bmp -- "I2C" --> tele

    motor -- "GPTW 20 kHz PWM<br/>MTU/TPU encoders" --> motors

    pi5 <== "SPI 10 Mbps<br/>HARQ Chase Combining<br/>FEC K=7 rate-1/2<br/>nanopb + CRC-32" ==> rx72n

    ui <-- "gRPC-Web :50051<br/>WebSocket :8080" --> gateway
    browser -- HTTP --> ui

    slam --> ekf
    ekf --> nav2
    ekf --> compliance
    slam --> compliance
    explore --> nav2
    compliance --> |PDF audit report| browser
