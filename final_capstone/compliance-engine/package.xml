<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>star_compliance</name>
  <version>0.1.0</version>
  <description>
    STAR ADA compliance engine. ROS2 nodes evaluating ADA 2010
    Standards 303 / 307 / 403.5 / 404.2.3 / 404.2.5 / 405.2 against
    the fused LiDAR + stereo + IMU + HC-SR04 sensor stack.
  </description>
  <maintainer email="locked-inc@tamu.edu">Team Locked Inc.</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs_py</depend>
  <depend>cv_bridge</depend>
  <depend>star_compliance_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
