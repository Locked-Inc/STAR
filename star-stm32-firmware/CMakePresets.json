{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
	    "toolchainFile": "${sourceDir}/cubeide-gcc.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "f767-debug",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-f767",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "STM32_TARGET": "STM32F767xx"
            }
        },
        {
            "name": "f767-release",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-f767",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "STM32_TARGET": "STM32F767xx"
            }
        },
        {
            "name": "f746-debug",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-f746",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "STM32_TARGET": "STM32F746xx"
            }
        },
        {
            "name": "f746-release",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-f746",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "STM32_TARGET": "STM32F746xx"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "f767-debug",
            "configurePreset": "f767-debug"
        },
        {
            "name": "f767-release",
            "configurePreset": "f767-release"
        },
        {
            "name": "f746-debug",
            "configurePreset": "f746-debug"
        },
        {
            "name": "f746-release",
            "configurePreset": "f746-release"
        }
    ]
}
