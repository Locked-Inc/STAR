digraph "Application Layer View" {
    rankdir=LR;
    node [shape=box style=filled fontname="Arial" fontsize=10];
    edge [color=navy fontsize=8];
    
    "star_bus_type_to_string" [fillcolor=lightblue];
    "star_bus_manager_deinit" [fillcolor=lightblue];
    "star_bus_config_create_i2c" [fillcolor=lightblue];
    "star_sensor_hcsr04_init" [fillcolor=lightblue];
    "star_bus_dht22_raw_to_humidity" [fillcolor=lightblue];
    "star_bus_dht22_calculate_checksum" [fillcolor=lightblue];
    "star_bus_config_destroy" [fillcolor=lightblue];
    "star_bus_config_create_gpio" [fillcolor=lightblue];
    "star_sensor_pca9685_set_duty_cycle" [fillcolor=lightblue];
    "star_bus_manager_find_bus" [fillcolor=lightblue];
    "star_bus_i2c_write" [fillcolor=lightblue];
    "star_register_pin" [fillcolor=lightcyan];
    "star_sensor_pca9685_calculate_prescale" [fillcolor=lightblue];
    "star_sensor_hcsr04_calculate_distance" [fillcolor=lightblue];
    "star_validate_pins" [fillcolor=lightcyan];
    "star_bus_config_deinit" [fillcolor=lightblue];
    "star_sensor_hcsr04_trigger" [fillcolor=lightblue];
    "star_bus_config_init" [fillcolor=lightblue];
    "star_bus_gpio_configure" [fillcolor=lightblue];
    "star_sensor_hcsr04_read_distance" [fillcolor=lightblue];
    "star_bus_dht22_read" [fillcolor=lightblue];
    "star_bus_i2c_read" [fillcolor=lightblue];
    "star_sensor_pca9685_set_pwm" [fillcolor=lightblue];
    "star_bus_manager_init" [fillcolor=lightblue];
    "star_sensor_hcsr04_get_result" [fillcolor=lightblue];
    "star_sensor_pca9685_set_channel_off" [fillcolor=lightblue];
    "star_sensor_pca9685_init" [fillcolor=lightblue];
    "star_bus_dht22_raw_to_celsius" [fillcolor=lightblue];
    "star_error_interface_destroy" [fillcolor=lightcyan];
    "star_error_interface_create_default" [fillcolor=lightcyan];
    "star_bus_manager_add_bus" [fillcolor=lightblue];
    "star_bus_gpio_write" [fillcolor=lightblue];
    "star_unregister_pin" [fillcolor=lightcyan];
    "star_bus_gpio_set_interrupt" [fillcolor=lightblue];
    "star_bus_gpio_init_default_ops" [fillcolor=lightblue];
    "star_bus_i2c_init_default_ops" [fillcolor=lightblue];
    "star_bus_dht22_init" [fillcolor=lightblue];
    "app_main" [fillcolor=lightgreen fontweight=bold];
    "app_main" -> "star_bus_config_create_gpio";
    "app_main" -> "star_bus_config_create_i2c";
    "app_main" -> "star_bus_config_destroy";
    "app_main" -> "star_bus_dht22_init";
    "app_main" -> "star_bus_dht22_read";
    "app_main" -> "star_bus_manager_add_bus";
    "app_main" -> "star_bus_manager_deinit";
    "app_main" -> "star_bus_manager_init";
    "app_main" -> "star_error_interface_create_default";
    "app_main" -> "star_error_interface_destroy";
    "app_main" -> "star_register_pin";
    "app_main" -> "star_sensor_hcsr04_init";
    "app_main" -> "star_sensor_hcsr04_read_distance";
    "app_main" -> "star_sensor_pca9685_init";
    "app_main" -> "star_sensor_pca9685_set_channel_off";
    "app_main" -> "star_sensor_pca9685_set_duty_cycle";
    "app_main" -> "star_unregister_pin";
    "app_main" -> "star_validate_pins";
    "star_bus_config_create_gpio" -> "star_bus_gpio_init_default_ops";
    "star_bus_config_create_i2c" -> "star_bus_i2c_init_default_ops";
    "star_bus_config_destroy" -> "star_bus_config_deinit";
    "star_bus_config_init" -> "star_bus_type_to_string";
    "star_bus_dht22_read" -> "star_bus_dht22_calculate_checksum";
    "star_bus_dht22_read" -> "star_bus_dht22_raw_to_celsius";
    "star_bus_dht22_read" -> "star_bus_dht22_raw_to_humidity";
    "star_bus_gpio_configure" -> "star_bus_manager_find_bus";
    "star_bus_gpio_set_interrupt" -> "star_bus_manager_find_bus";
    "star_bus_gpio_write" -> "star_bus_manager_find_bus";
    "star_bus_i2c_write" -> "star_bus_manager_find_bus";
    "star_bus_manager_add_bus" -> "star_bus_config_init";
    "star_bus_manager_add_bus" -> "star_bus_type_to_string";
    "star_bus_manager_deinit" -> "star_bus_config_destroy";
    "star_sensor_hcsr04_get_result" -> "star_sensor_hcsr04_calculate_distance";
    "star_sensor_hcsr04_init" -> "star_bus_gpio_configure";
    "star_sensor_hcsr04_init" -> "star_bus_gpio_set_interrupt";
    "star_sensor_hcsr04_init" -> "star_bus_gpio_write";
    "star_sensor_hcsr04_read_distance" -> "star_sensor_hcsr04_get_result";
    "star_sensor_hcsr04_read_distance" -> "star_sensor_hcsr04_trigger";
    "star_sensor_hcsr04_trigger" -> "star_bus_gpio_write";
    "star_sensor_pca9685_calculate_prescale" -> "star_bus_i2c_read";
    "star_sensor_pca9685_calculate_prescale" -> "star_bus_i2c_write";
    "star_sensor_pca9685_init" -> "star_bus_i2c_write";
    "star_sensor_pca9685_init" -> "star_sensor_pca9685_calculate_prescale";
    "star_sensor_pca9685_set_channel_off" -> "star_bus_i2c_write";
    "star_sensor_pca9685_set_duty_cycle" -> "star_sensor_pca9685_set_pwm";
    "star_sensor_pca9685_set_pwm" -> "star_bus_i2c_write";

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor=white;
        "Entry Point" [fillcolor=lightgreen];
        "STAR Core" [fillcolor=lightblue];
        "STAR Utils" [fillcolor=lightcyan];
        "ESP-IDF" [fillcolor=lightyellow];
        "Drivers" [fillcolor=lightgray];
        "System" [fillcolor=mistyrose];
    }
}