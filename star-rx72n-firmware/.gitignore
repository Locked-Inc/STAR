# Doxygen generated output (run: make doxygen-html / make doxygen-pdfs)
# HTML output is fully regenerable -- ignore the whole tree
docs/doxygen/html/
# XML output (GENERATE_XML)
docs/doxygen/xml/
# HTML and LaTeX intermediates under each per-module PDF dir -- large and regenerable
docs/doxygen/pdf/*/html/
docs/doxygen/pdf/*/latex/
# Doxygen warning/log files
docs/doxygen/pdf/*/*.log
# Named PDFs (docs/doxygen/pdf/<name>/<name>.pdf) are intentionally NOT ignored

# Test build artifacts
tests/build/
tests/Unity/

# e2-studio (Renesas Eclipse) IDE artifacts
HardwareDebug/
output/
.metadata/
.settings/

# CMake build artifacts
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.elf
*.bin
*.hex
*.map

# GCC coverage instrumentation files
*.gcov
*.gcda
*.gcno
*.gcov.json.gz

# GCC RTL dump files (generated by -fdump-rtl-expand for call graph analysis)
*.expand

# Temporary files
*.tmp
*.bak
*~

# Temporary Doxyfiles generated by make doxygen-pdf-* (mktemp Doxyfile.<name>.XXXXXX)
# Pattern matches exactly 6 trailing chars -- won't catch Doxyfile.main or Doxyfile.pdf.base
Doxyfile.*.??????

