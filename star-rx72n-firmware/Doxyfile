# Doxygen configuration for STAR RX72N Firmware
#
# FULL DOCUMENTATION MODE
#
# Features enabled:
# - INPUT: src/ lib/ include/ (all project code)
# - HAVE_DOT: YES (graphs enabled - requires graphviz: apt-get install graphviz)
# - EXTRACT_*: Full extraction (private, static, local methods, etc.)
# - SOURCE_BROWSER: YES (cross-referenced source code)
# - Call graphs, include graphs, collaboration diagrams: ALL ENABLED
# - EXCLUDE: ThreadX library (too large, external dependency)

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------
PROJECT_NAME           = "STAR RX72N Firmware"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "ThreadX-based motor control firmware for Renesas RX72N"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = YES
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------
# Full extraction enabled for complete documentation
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES

#---------------------------------------------------------------------------
# Configuration options related to warning and progress messages
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------
# Full documentation of entire codebase
INPUT                  = src/ lib/ include/ tests/
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.cpp *.hpp *.S
RECURSIVE              = YES

EXCLUDE_PATTERNS       = */build/* \
                        */docs/* \
                        */scripts/* \
                        */threadx/* \
                        */rx_nanopb/nanopb/*

#---------------------------------------------------------------------------
# Configuration options related to source browsing
#---------------------------------------------------------------------------
# Full source browsing enabled for complete documentation
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

#---------------------------------------------------------------------------
# Configuration options related to the alphabetical class index
#---------------------------------------------------------------------------
ALPHABETICAL_INDEX     = YES

#---------------------------------------------------------------------------
# Configuration options related to the HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
GENERATE_TREEVIEW      = YES
ENUM_VALUES_PER_LINE   = 4
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO

#---------------------------------------------------------------------------
# Configuration options related to the LaTeX output
#---------------------------------------------------------------------------
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = pdflatex
LATEX_PDF_SIZE         = LETTER
LATEX_GRAPH_MAX_WIDTH  = 90%
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
LATEX_MAKEFILE         = Makefile
LATEX_EXTRA_STYLESHEET = my_doxy_style.sty
EXTRA_PACKAGES         = etex

# Doxygen layout file
# Note: Using pdflatex instead of xelatex for compatibility
# Removed fontspec (xelatex-specific) and dejavu fonts
LATEX_FONT_FAMILY      =
LATEX_MONOSPACE_FONT   =


#---------------------------------------------------------------------------
# Configuration options related to the RTF output
#---------------------------------------------------------------------------
GENERATE_RTF           = NO

#---------------------------------------------------------------------------
# Configuration options related to the man page output
#---------------------------------------------------------------------------
GENERATE_MAN           = NO

#---------------------------------------------------------------------------
# Configuration options related to the XML output
#---------------------------------------------------------------------------
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Configuration options related to the preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include/ \
                        lib/threadx/common/inc \
                        lib/threadx/ports/rxv3/gnu/inc

PREDEFINED             = __RX_LITTLE_ENDIAN__=1 \
                        __RX=1 \
                        STAR_FIRMWARE_VERSION=\"1.0.0\" \
                        __DOXYGEN__

#---------------------------------------------------------------------------
# Configuration options related to external references
#---------------------------------------------------------------------------
TAGFILES               =
GENERATE_TAGFILE       =
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES

#---------------------------------------------------------------------------
# Configuration options related to the dot tool
#---------------------------------------------------------------------------
# Full graphing enabled for complete documentation
# Note: Requires graphviz to be installed (apt-get install graphviz)
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_FONTNAME           = Helvetica
DOT_FONTPATH           =
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = pdf
DOT_CLEANUP            = YES
COMPACT_LATEX          = YES
LATEX_HIDE_INDICES     = NO

#---------------------------------------------------------------------------
# Configuration options related to the search engine
#---------------------------------------------------------------------------
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
