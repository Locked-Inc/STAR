---
# STAR RX72N Firmware - clang-tidy configuration
#
# Run against the host-compiled test build (tests/build/compile_commands.json)
# because the cross-compiler (rx-elf-gcc) emits RX72N-specific flags that
# LLVM cannot parse.  All firmware source files are compiled into the test
# build via standard gcc/clang, so full coverage is achieved.
#
# Minimum clang version: 16 (required for C23 typed enum syntax).
# Ubuntu 24.04 ships clang-18 via the unversioned 'clang-tidy' package.
#
# Usage:
#   cmake -B build/tidy -S tests/ -DENABLE_CLANG_TIDY=ON
#   cmake --build build/tidy
#
# Or via script:
#   bash star-rx72n-firmware/scripts/clang_tidy.sh --check

Checks: >
  cert-*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  readability-*,
  portability-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -readability-identifier-length,
  -performance-no-int-to-ptr

# ALL warnings are errors -- zero tolerance for any clang-tidy violation.
WarningsAsErrors: '*'

# Only report diagnostics for STAR-authored headers; suppress noise from
# vendor headers (threadx, nanopb generated, smc, r_bsp, _deps) and test
# mock headers that use ThreadX naming conventions.
HeaderFilterRegex: '^(?!.*(threadx|nanopb|smc_gen|smc/|r_bsp|_deps|tests/mocks|rx_nanopb/inc/gen|rx72n_.*_regs)).*\.(h|hpp)$'

CheckOptions:
  # --- readability-identifier-naming (CLAUDE.md naming conventions) ---

  # Functions: snake_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  # Allow UPPER_CASE for hardware ISR vector names (e.g., INT_IRQ8..INT_IRQ11)
  # that are mandated by the Renesas RX72N hardware/linker and cannot be renamed.
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^INT_IRQ[0-9]+$'

  # Variables: snake_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case

  # Local variables: snake_case (no prefix)
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # Local constants: snake_case (no prefix)
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case

  # Parameters: snake_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  # Const parameters: snake_case (no prefix)
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case

  # Types (struct/typedef/enum): snake_case with trailing _t
  - key: readability-identifier-naming.TypedefCase
    value: lower_case
  - key: readability-identifier-naming.TypedefSuffix
    value: _t
  # Allow _fn suffix for function pointer typedefs (e.g. rx_error_report_fn)
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '.*_fn$'

  # Struct names: snake_case (without _t -- the typedef carries it)
  - key: readability-identifier-naming.StructCase
    value: lower_case

  # Enum tag names: snake_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case

  # Enum constants: k_ prefix, lower_case (project convention)
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k_

  # Macros: UPPER_CASE (SCREAMING_SNAKE_CASE)
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  # Allow lowercase macros for function-like logging/check macros and
  # vendor ThreadX shims (tx_thread_sleep, etc.)
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^(rx_log_|tx_|star_v1_|google_protobuf_|_R_BSP_|__R_BSP_|__RX).*'

  # Global variables (non-static, non-const): g_ prefix
  # Note: clang-tidy classifies file-scope 'static' vars as "global" in C.
  # IgnoredRegexp accepts our s_ prefix for file-scope statics while still
  # enforcing g_ for true (non-static) globals.
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: g_
  - key: readability-identifier-naming.GlobalVariableIgnoredRegexp
    value: '^s_.*'

  # Global constants (non-static const): g_ prefix
  # IgnoredRegexp accepts s_ (static impl details) and k_ (named constants).
  - key: readability-identifier-naming.GlobalConstantCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: g_
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^(s_|k_).*'

  # Static variables (non-const): s_ prefix
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.StaticVariablePrefix
    value: s_

  # Static constants: lower_case, accept both s_ and k_ prefixes.
  # s_ for implementation details (s_tag), k_ for named constants (k_max_retries).
  # No prefix enforcement -- both conventions are valid per CLAUDE.md.
  - key: readability-identifier-naming.StaticConstantCase
    value: lower_case

  # --- cert-str34-c: cast char to unsigned char before conversion ---
  - key: cert-str34-c.DiagnoseSignedUnsignedCharComparisons
    value: true

  # --- readability-magic-numbers: allow 0 and 1 as universally benign ---
  # These are the only numeric literals permitted without a named constant.
  # All other numeric literals must use typed enum constants per CLAUDE.md.
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: "0;1"
  - key: readability-magic-numbers.IgnoredFloatingPointValues
    value: "0.0;1.0"

  # --- readability-function-cognitive-complexity: NASA Power of 10 Rule 4 ---
  # Functions exceeding this threshold are flagged for refactoring.
  # Threshold of 25 allows complex-but-verifiable control flow while
  # preventing untestable "god functions" that violate Rule 4.
  - key: readability-function-cognitive-complexity.Threshold
    value: "25"

  # --- readability-function-size: Clean Code / NASA Rule 4 function-length limit ---
  # Functions over 60 lines are flagged. This matches the ~one-printed-page rule
  # from Clean Code (Robert C. Martin) and NASA Power of 10 Rule 4.
  # StatementThreshold catches bloated switch/case functions that stay under 60 lines.
  - key: readability-function-size.LineThreshold
    value: "60"
  - key: readability-function-size.StatementThreshold
    value: "40"
  - key: readability-function-size.NestingThreshold
    value: "4"
