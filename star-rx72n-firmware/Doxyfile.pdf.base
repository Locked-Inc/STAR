# Doxyfile.pdf.base -- PDF-mode overrides for STAR RX72N Firmware Doxygen
#
# This file is NOT run directly. It is @INCLUDE'd at the top of per-module
# temp Doxyfiles generated by the Makefile (make doxygen-pdf-<name>).
#
# The include chain is:
#   <temp per-module Doxyfile>
#     @INCLUDE = Doxyfile.pdf.base     (this file)
#       @INCLUDE = Doxyfile.main      (HTML main -- sets all base options)
#
# Per-module temp files add these settings AFTER the @INCLUDE, overriding:
#   PROJECT_NAME     -- module-specific title
#   INPUT            -- module-specific source path (e.g. libs/rx_pid)
#   OUTPUT_DIRECTORY -- module-specific output dir (e.g. docs/doxygen/pdf/rx_pid)
#   WARN_LOGFILE     -- module-specific warning log

@INCLUDE               = Doxyfile.main

#---------------------------------------------------------------------------
# Flip output: LaTeX only, no HTML
#---------------------------------------------------------------------------
GENERATE_HTML          = NO
GENERATE_LATEX         = YES
GENERATE_XML           = NO

# No tag file for PDF volumes -- cross-PDF links are not resolvable
GENERATE_TAGFILE       =

#---------------------------------------------------------------------------
# LaTeX engine: xelatex (no register limits; matches existing Makefile strategy)
# Compilation: xelatex -no-pdf (twice) + xdvipdfmx  -- handled by Makefile
#---------------------------------------------------------------------------
LATEX_CMD_NAME         = xelatex
USE_PDFLATEX           = NO

#---------------------------------------------------------------------------
# Graphviz: switch SVG -> PNG for LaTeX
# Doxygen 1.16.1 does NOT support pdf as a DOT_IMAGE_FORMAT value (warns
# "not a valid enum value" and silently falls back to png anyway). Use png
# explicitly so xelatex can include the dot graphs via \includegraphics.
# Interactive SVG is browser-only, disabled here.
#---------------------------------------------------------------------------
DOT_IMAGE_FORMAT       = png
INTERACTIVE_SVG        = NO

#---------------------------------------------------------------------------
# All heavy graph options stay ENABLED (same as HTML) -- the per-module scope
# keeps each PDF small enough for XeLaTeX to compile.
#   CALL_GRAPH, CALLER_GRAPH, CLASS_GRAPH, COLLABORATION_GRAPH
#   INCLUDE_GRAPH, INCLUDED_BY_GRAPH, GRAPHICAL_HIERARCHY, DIRECTORY_GRAPH
# These are inherited from Doxyfile.main (all = YES / DOT_GRAPH_MAX_NODES = 250)
# and are NOT overridden here intentionally.
#---------------------------------------------------------------------------
