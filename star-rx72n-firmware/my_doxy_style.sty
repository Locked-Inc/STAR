% Custom LaTeX style for STAR RX72N Doxygen documentation
%
% Fixes Unicode character handling for common symbols

% Declare common Unicode characters that may appear in code comments

% Math symbols
\DeclareUnicodeCharacter{2212}{-}  % Unicode minus sign → ASCII hyphen
\DeclareUnicodeCharacter{2013}{--} % En dash
\DeclareUnicodeCharacter{2014}{---} % Em dash
\DeclareUnicodeCharacter{2026}{\dots} % Ellipsis
\DeclareUnicodeCharacter{00B0}{\textdegree} % Degree symbol
\DeclareUnicodeCharacter{00B5}{\textmu} % Micro symbol
\DeclareUnicodeCharacter{2264}{\ensuremath{\le}} % Less than or equal
\DeclareUnicodeCharacter{2265}{\ensuremath{\ge}} % Greater than or equal
\DeclareUnicodeCharacter{2248}{\ensuremath{\approx}} % Approximately equal
\DeclareUnicodeCharacter{00D7}{\ensuremath{\times}} % Multiplication sign
\DeclareUnicodeCharacter{00F7}{\ensuremath{\div}} % Division sign
\DeclareUnicodeCharacter{00B1}{\ensuremath{\pm}} % Plus-minus
\DeclareUnicodeCharacter{2260}{\ensuremath{\ne}} % Not equal
\DeclareUnicodeCharacter{221E}{\ensuremath{\infty}} % Infinity

% Greek letters (commonly used in robotics/control systems)
\DeclareUnicodeCharacter{03B1}{\ensuremath{\alpha}} % Alpha
\DeclareUnicodeCharacter{03B2}{\ensuremath{\beta}} % Beta
\DeclareUnicodeCharacter{03B3}{\ensuremath{\gamma}} % Gamma
\DeclareUnicodeCharacter{03B4}{\ensuremath{\delta}} % Delta
\DeclareUnicodeCharacter{03B5}{\ensuremath{\epsilon}} % Epsilon
\DeclareUnicodeCharacter{03B8}{\ensuremath{\theta}} % Theta
\DeclareUnicodeCharacter{03BB}{\ensuremath{\lambda}} % Lambda
\DeclareUnicodeCharacter{03BC}{\ensuremath{\mu}} % Mu
\DeclareUnicodeCharacter{03C0}{\ensuremath{\pi}} % Pi
\DeclareUnicodeCharacter{03C1}{\ensuremath{\rho}} % Rho
\DeclareUnicodeCharacter{03C3}{\ensuremath{\sigma}} % Sigma
\DeclareUnicodeCharacter{03C4}{\ensuremath{\tau}} % Tau
\DeclareUnicodeCharacter{03C6}{\ensuremath{\phi}} % Phi
\DeclareUnicodeCharacter{03C9}{\ensuremath{\omega}} % Omega
\DeclareUnicodeCharacter{0394}{\ensuremath{\Delta}} % Capital Delta
\DeclareUnicodeCharacter{03A9}{\ensuremath{\Omega}} % Capital Omega

