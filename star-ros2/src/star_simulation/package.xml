<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>star_simulation</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation for STAR robot platform</description>
  <maintainer email="cesar@locked-inc.com">Cesar Magana</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- TF and robot description -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Gazebo Harmonic integration -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- SLAM + sensor fusion (configs reused from star_bringup) -->
  <exec_depend>star_bringup</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <!-- Nav2 navigation stack -->
  <exec_depend>nav2_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros2</test_depend>
  <test_depend>nav2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
