<?xml version="1.0"?>
<!--
  Gazebo Harmonic plugin declarations for STAR simulation.
  Included by star_sim.urdf.xacro. Declares the DiffDrive controller,
  joint state publisher, IMU sensor, and lidar sensor.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- DiffDrive: 4-wheel skid steer (2 left + 2 right joints)            -->
  <!-- Subscribes /model/star/cmd_vel, publishes /model/star/odometry      -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <!-- wheel_separation: track width (left-to-right wheel center-to-center)
           in meters. Source: CAD measurement, 304 mm inside-of-wheel-to-
           inside-of-wheel + 52 mm goBILDA Wasteland wheel width. Must match
           the gateway/SPI bridge ROS2 parameters used for diff-drive. -->
      <wheel_separation>0.356</wheel_separation>
      <!-- wheel_radius: rolling radius in meters. Source: goBILDA Wasteland
           144 mm wheel (part 3616-0014-0144), diameter / 2. -->
      <wheel_radius>0.072</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Joint state publisher: wheel positions and velocities               -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>back_left_wheel_joint</joint_name>
      <joint_name>back_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ================================================================== -->
  <!-- IMU sensor on imu_link (simulates MPU-9250)                         -->
  <!-- ================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <enable_orientation>true</enable_orientation>
        <angular_velocity>
          <x><noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise></x>
          <y><noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise></y>
          <z><noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise></x>
          <y><noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise></y>
          <z><noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Lidar on laser_frame (simulates RPLiDAR C1)                         -->
  <!-- 360 deg, 640 samples, 12 m range, 10 Hz                            -->
  <!-- Uses CPU ray sensor (not gpu_lidar) for Pi5/CI compatibility.       -->
  <!-- ================================================================== -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================================================================== -->
  <!-- HC-SR04 ultrasonic sensors (4x, narrow-FOV ray sensors)             -->
  <!-- Range: 0.02 - 4.0 m, ~15 deg beam, 10 Hz                           -->
  <!-- Topics match real robot: /star/obstacle/{front,back}_{left,right}   -->
  <!-- ================================================================== -->
  <xacro:macro name="sonar_sensor" params="name link_name">
    <gazebo reference="${link_name}">
      <sensor name="${name}_sonar" type="lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>star/obstacle/${name}</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.1309</min_angle>
              <max_angle>0.1309</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:sonar_sensor name="front_left"  link_name="front_left_sonar_link"/>
  <xacro:sonar_sensor name="front_right" link_name="front_right_sonar_link"/>
  <xacro:sonar_sensor name="back_left"   link_name="back_left_sonar_link"/>
  <xacro:sonar_sensor name="back_right"  link_name="back_right_sonar_link"/>

  <!-- ================================================================== -->
  <!-- Wheel friction: rubber on concrete                                  -->
  <!-- ================================================================== -->
  <gazebo reference="front_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
  </gazebo>
  <gazebo reference="back_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
  </gazebo>
  <gazebo reference="back_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
  </gazebo>

</robot>
