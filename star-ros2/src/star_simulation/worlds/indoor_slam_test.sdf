<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="indoor_slam_test">

    <!-- Required system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- Physics: 1 ms step, real-time -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene lighting -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <!-- Directional sun light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Indoor floorplan: ~6 x 8 m
      Two rooms connected by a corridor with door openings.

      Layout (top view, Y up, X right):

        +=============================+
        |            |     |          |
        |  Room A    | cor |  Room B  |
        |  (3x4)     | rid |  (3x4)  |
        |            | or  |          |
        |            |     |          |
        +=============================+

      Wall thickness: 0.1 m
      Door openings: 0.8 m wide
    -->

    <!-- Outer walls -->
    <!-- North wall (y=+4) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.5 1</ambient>
            <diffuse>0.6 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall (y=-4) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.5 1</ambient>
            <diffuse>0.6 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall (x=-4) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.5 1</ambient>
            <diffuse>0.6 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall (x=+4) -->
    <model name="wall_east">
      <static>true</static>
      <pose>4.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.5 1</ambient>
            <diffuse>0.6 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Interior divider wall at x=0, with a 0.8 m door opening centered at y=0.
      Split into two segments: upper (y=+0.4 to y=+4) and lower (y=-4 to y=-0.4).
    -->
    <!-- Divider upper segment -->
    <model name="divider_upper">
      <static>true</static>
      <pose>0 2.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.6 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.4 1</ambient>
            <diffuse>0.5 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Divider lower segment -->
    <model name="divider_lower">
      <static>true</static>
      <pose>0 -2.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.6 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.4 1</ambient>
            <diffuse>0.5 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacles in Room A (x < 0) -->
    <model name="obstacle_box_a1">
      <static>true</static>
      <pose>-2.5 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.3 0.3 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_a1">
      <static>true</static>
      <pose>-1.5 -1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.8 0.3 1</ambient>
            <diffuse>0.3 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacles in Room B (x > 0) -->
    <model name="obstacle_box_b1">
      <static>true</static>
      <pose>2.0 1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.8 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.8 0.4</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.8 1</ambient>
            <diffuse>0.3 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_b1">
      <static>true</static>
      <pose>2.5 -2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.8 0.3 1</ambient>
            <diffuse>0.8 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small table-like obstacle near the door -->
    <model name="obstacle_table">
      <static>true</static>
      <pose>0.8 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material>
            <ambient>0.5 0.4 0.3 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
