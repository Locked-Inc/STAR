# STAR RViz profile notes:
# - Grid Name: "Grid", Reference Frame: <Fixed Frame>
# - Alpha: 0.3 for low-contrast background context without obscuring scan/map overlays.
# - Cell Size: 1 and Plane Cell Count: 20 to show a 20 m reference area around robot.
# - Line Width: 0.03 balances visibility at typical zoom while keeping render cost low.
# - LaserScan tuning: Size (Pixels)=3 boosts point visibility, Size (m)=0.05 keeps metric
#   scale legible, Min/Max Intensity (0.15/10) match observed sensor intensity range,
#   FlatColor + Autocompute bounds keep color stable while preserving contrast.
# - Global Options: Frame Rate=30 balances smooth SLAM visualization with Pi 5 CPU/GPU budget;
#   Fixed Frame=map is intentional for map-centric SLAM monitoring.
# - Current View: Pitch=1.5707963705062866 is pi/2 (90 deg) top-down; Near Clip Distance
#   and Stereo Eye Separation values are RViz serialization artifacts and should not be
#   retuned unless camera behavior changes.
# These values are tuned for operator readability and stable RViz performance on Pi 5.
Panels:
  - Class: rviz_common/Displays
    Help Height: 78  # Height (px) of the help text below the Displays tree; auto-generated by RViz from last session (RViz default).
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
        - /TF1
        - /Map1
      Splitter Ratio: 0.5  # Equal split between the Displays tree and the properties pane; RViz serialization default (0.5 = 50/50).
    Tree Height: 617  # Height (px) of the Displays property tree; auto-generated by RViz to fill a ~1080p development window.
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: 0.15
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LaserScan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5  # 5-frame buffer: smooths updates at ~10 Hz scan rate without accumulating lag; Depth 1 drops under burst load, Depth 10 adds perceptible latency.
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 2  # Units: seconds. Allows brief sensor hiccups without dropping the fixed frame; balances latency (Depth 1 would fail transiently) vs robustness.
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 0.7  # Balance map readability with LaserScan overlay visibility.
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic:
        Depth: 1  # Only the latest map is useful; Transient Local QoS delivers the full map to late joiners so a larger buffer wastes memory and risks serving a stale map.
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Alpha: 1
      Enabled: true
      Name: RobotModel
      Topic:
        Depth: 5  # Matches robot_state_publisher default QoS; Transient Local is the primary latching mechanism so Depth 1 would suffice, but 5 provides a safety margin for reconnects (no latency cost since robot_description is published once).
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
      Visual Enabled: true
      Collision Enabled: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.5707963705062866
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0
    Saved: ~
Window Geometry:
  # Geometry recorded on a 1280x900 development window on a 1920x1080 display.
  # RViz will auto-adjust window placement and size on different screen resolutions.
  Displays:
    collapsed: false
  Height: 900  # Target window height (px) at development time; RViz auto-scales on different displays.
  Hide Left Dock: false
  Hide Right Dock: true
  Selection:
    collapsed: false
  Views:
    collapsed: false
  Width: 1280  # Target window width (px) at development time; RViz auto-scales on different displays.
  X: 0
  Y: 0
