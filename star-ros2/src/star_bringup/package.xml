<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>star_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and system bringup for STAR platform</description>
  <maintainer email="cesar@locked-inc.com">Cesar Magana</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- TF and robot description -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- SLAM + sensor fusion -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>

  <!-- Nav2 navigation stack -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>

  <!-- Frontier exploration: built from source (not in rosdep index).
       Clone: https://github.com/robo-friends/m-explore-ros2.git
       Pass ignore-src flag to rosdep install to skip this dependency. -->
  <exec_depend>explore_lite</exec_depend>

  <!-- Foxglove Studio WebSocket bridge (optional, gated by use_foxglove arg) -->
  <exec_depend>foxglove_bridge</exec_depend>

  <!-- Stereo camera: Waveshare IMX219-83 via GStreamer + libcamerasrc -->
  <exec_depend>gscam</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
