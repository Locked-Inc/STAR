# .clang-format for ROS2 C++ code in STAR project
# Aligned with ROS2 uncrustify style guide

BasedOnStyle: LLVM

#----------------------------------------------------------------------------
# Indentation
#----------------------------------------------------------------------------
IndentWidth: 2
UseTab: Never
ContinuationIndentWidth: 2
IndentCaseLabels: true
NamespaceIndentation: None  # ROS2 convention: no indent inside namespace

#----------------------------------------------------------------------------
# Braces and Blocks
#----------------------------------------------------------------------------
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: false  # Cuddle braces for if/while/for
  AfterFunction: true           # Functions on new line
  AfterClass: true              # ROS2: class braces on new line
  AfterStruct: true             # ROS2: struct braces on new line
  AfterUnion: false
  AfterEnum: false
  AfterNamespace: true          # ROS2: namespace braces on new line
  BeforeCatch: false
  BeforeElse: false
  BeforeWhile: false

AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty

#----------------------------------------------------------------------------
# Spacing
#----------------------------------------------------------------------------
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpacesInAngles: false

# ROS2 uncrustify style: space on both sides of & and *
# This creates: Type & ref, Type * ptr (not Type& ref, Type* ptr)
SpaceBeforeRangeBasedForLoopColon: true

#----------------------------------------------------------------------------
# Line Breaking and Wrapping
#----------------------------------------------------------------------------
ColumnLimit: 100  # ROS2 cpplint standard

AlignAfterOpenBracket: Align
BinPackParameters: false
BinPackArguments: false
AlwaysBreakTemplateDeclarations: Yes

#----------------------------------------------------------------------------
# Comment Handling
#----------------------------------------------------------------------------
ReflowComments: false
AlignTrailingComments: true
SpacesBeforeTrailingComments: 2  # ROS2: 2 spaces before inline comments

#----------------------------------------------------------------------------
# Alignment
#----------------------------------------------------------------------------
AlignConsecutiveMacros: Consecutive
AlignConsecutiveDeclarations: false  # ROS2: Don't force align all declarations
AlignConsecutiveAssignments: false   # ROS2: Don't force align all assignments
PointerAlignment: Right               # ROS2: Type & ref, Type * ptr
ReferenceAlignment: Right             # ROS2: Type & ref
DerivePointerAlignment: false

#----------------------------------------------------------------------------
# Includes (ROS2-specific order)
#----------------------------------------------------------------------------
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  # 1. Main header (if applicable)
  - Regex:           '^".*\.hpp"'
    Priority:        1
  # 2. C system headers
  - Regex:           '^<(assert|ctype|errno|float|limits|locale|math|setjmp|signal|stdarg|stddef|stdio|stdlib|string|time|fcntl|sys|unistd)\.h>'
    Priority:        2
  # 3. C++ system headers
  - Regex:           '^<.*>'
    Priority:        3
  # 4. ROS2 and third-party headers (tf2, etc)
  - Regex:           '^<(rclcpp|std_msgs|geometry_msgs|sensor_msgs|nav_msgs|tf2).*>'
    Priority:        4
  # 5. Local project headers
  - Regex:           '^"'
    Priority:        5

#----------------------------------------------------------------------------
# Miscellaneous
#----------------------------------------------------------------------------
AccessModifierOffset: -2
IndentAccessModifiers: false
EmptyLineBeforeAccessModifier: LogicalBlock
FixNamespaceComments: true
