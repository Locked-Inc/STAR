{
    "name": "STAR ROS2 Jazzy Devcontainer",
    "dockerFile": "../Dockerfile",
    "runArgs": [
        "--net=host",
        "--ipc=host"
        // Uncomment device flags for RPi5 hardware access:
        // "--device=/dev/spidev0.0",    // RX72N motor controller (SPI)
        // "--device=/dev/ttyUSB0",       // RPLiDAR C1 (USB-Serial)
        // "--device=/dev/video0",        // OAK-D camera (stereo vision)
        // "--device=/dev/video1",
        // "-v", "/run/udev:/run/udev:ro"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "ROS_DOMAIN_ID": "42"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-iot.vscode-ros",
                "zxh404.vscode-proto3",
                "twxs.cmake",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    "remoteUser": "star",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspaces/STAR,type=bind"
    ],
    "postCreateCommand": "bash -c 'if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then sudo rosdep init && rosdep update --rosdistro jazzy; fi'"
}
