{
    "name": "STAR ROS2 Jazzy Devcontainer",
    "dockerFile": "../Dockerfile",
    "runArgs": [
        "--privileged",
        "--net=host",
        "--ipc=host",
        "-v", "/dev:/dev",
        "-v", "/run/udev:/run/udev:ro"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "ROS_DOMAIN_ID": "42"
    },
    "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
    },
    "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-iot.vscode-ros",
        "zxh404.vscode-proto3",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
    ],
    "remoteUser": "star",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspaces/STAR,type=bind"
    ],
    "postCreateCommand": "test -f /etc/ros/rosdep/sources.list.d/20-default.list || sudo rosdep init && rosdep update --rosdistro jazzy"
}
