{
  "name": "Existing Dockerfile",
  "remoteUser": "star",
  "initializeCommand": "cd .devcontainer && (bash ./init.sh || true)",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "args": {
      "BUILDPLATFORM": "linux/amd64"
    }
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/star/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/star/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/home/star/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/opencode,target=/home/star/.config/opencode,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/openai,target=/home/star/.config/openai,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "HOME": "/home/star"
  },
  "onCreateCommand": "git lfs install && git lfs pull && sudo chown -R star:star /home/star/.cache /home/star/.local /home/star/.npm 2>/dev/null; mkdir -p /home/star/.config /home/star/.ssh /home/star/.cache && touch /home/star/.gitconfig && go install github.com/golangci/golangci-lint/cmd/golangci-lint@v1.64.8 && npm i -g opencode-ai @openai/codex",
  "updateContentCommand": "cd star-proto/proto && buf mod update && cd ../..",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "bufbuild.vscode-buf",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/star-ros2/build",
          "--background-index",
          "--clang-tidy"
        ]
      }
    }
  }
}