{
  "name": "Existing Dockerfile",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers-extra/features/act:1": {},
    "ghcr.io/devcontainers-extra/features/actionlint:1": {},
    "ghcr.io/devcontainers-extra/features/claude-code:1": {},
    "ghcr.io/siri404/devcontainer-ai-features/gemini-cli:1": {},
    "ghcr.io/devcontainer-config/features/dot-config:3": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.gemini,target=/home/star/.gemini,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/star/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/star/.claude.json,type=bind,consistency=cached"
  ],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y clang-format clang clangd && go install github.com/golangci/golangci-lint/cmd/golangci-lint@v1.64.8",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "bufbuild.vscode-buf",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "ryanluker.vscode-coverage-gutters",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one",
        "gruntfuggly.todo-tree",
        "streetsidesoftware.code-spell-checker",
        "EditorConfig.EditorConfig",
        "usernamehw.errorlens"
      ],
      "settings": {
        "cmake.configureArgs": ["-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/star-ros2/build",
          "--background-index",
          "--clang-tidy"
        ]
      }
    }
  }
}
