{
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=e2-studio-star-rx72n-firmware/build",
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never"
  ],
  "go.useLanguageServer": true,
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true,
    "analyses": {
      "unusedparams": true,
      "shadow": true,
      "nilness": true
    },
    "staticcheck": true,
    "codelenses": {
      "test": true,
      "generate": true
    }
  },
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features"
  },
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.enabled": "ignore",
  "markdown.validate.fragmentLinks.enabled": "warning",
  "markdown.validate.ignoredLinks": [
    "../../../CLAUDE.md#nasa-power-of-10-rules-star-implementation",
    "../../../CLAUDE.md#solid-principles-for-c-star-implementation",
    "../../../CLAUDE.md#code-style",
    "../../../CLAUDE.md#naming-conventions",
    "../../../CLAUDE.md#doxygen-documentation-requirements",
    "../../../CLAUDE.md#terminology-standard"
  ],
  "cmake.sourceDirectory": "/workspaces/STAR/e2-studio-star-rx72n-firmware",
  "protobuf.externalLinter.enabled": true,
  "protobuf.externalLinter.linter": "buf",
  "protobuf.externalLinter.bufPath": "/usr/local/bin/buf",
  "protobuf.protoSrcsDir": "star-proto/proto",
  "files.associations": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**/*.proto": "plaintext"
  },
  "files.exclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "search.exclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "files.watcherExclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "problems.exclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  }
  
}
