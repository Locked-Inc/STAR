{
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=e2-studio-star-rx72n-firmware/build",
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never"
  ],
  "go.useLanguageServer": true,
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true,
    "analyses": {
      "unusedparams": true,
      "shadow": true,
      "nilness": true
    },
    "staticcheck": true,
    "codelenses": {
      "test": true,
      "generate": true
    }
  },
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.enabled": false,
  "markdown.validate.fragmentLinks.enabled": true,
  "markdown.validate.ignoredLinks": [
    "../../../CLAUDE.md#nasa-power-of-10-rules-star-implementation",
    "../../../CLAUDE.md#solid-principles-for-c-star-implementation",
    "../../../CLAUDE.md#code-style",
    "../../../CLAUDE.md#naming-conventions",
    "../../../CLAUDE.md#doxygen-documentation-requirements",
    "../../../CLAUDE.md#terminology-standard"
  ],
  "cmake.sourceDirectory": "/workspaces/STAR/e2-studio-star-rx72n-firmware"
}
