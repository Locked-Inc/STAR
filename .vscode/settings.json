{
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=e2-studio-star-rx72n-firmware/build",
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never"
  ],
  "go.useLanguageServer": true,
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true,
    "analyses": {
      "unusedparams": true,
      "shadow": true,
      "nilness": true,
      "ST1000": false
    },
    "staticcheck": true,
    "codelenses": {
      "test": true,
      "generate": true
    },
    "directoryFilters": [
      "-star-proto/gen"
    ]
  },
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "golangci-lint.configFilePath": "",
  "go.lintFlags": [
    "--exclude-dirs=star-proto/gen"
  ],
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[proto]": {
    "editor.defaultFormatter": "DrBlury.protobuf-vsc",
    "editor.formatOnSave": true
  },
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.enabled": false,
  "markdown.validate.fragmentLinks.enabled": true,
  "markdown.validate.ignoredLinks": [
    "../../../CLAUDE.md#nasa-power-of-10-rules-star-implementation",
    "../../../CLAUDE.md#solid-principles-for-c-star-implementation",
    "../../../CLAUDE.md#code-style",
    "../../../CLAUDE.md#naming-conventions",
    "../../../CLAUDE.md#doxygen-documentation-requirements",
    "../../../CLAUDE.md#terminology-standard"
  ],
  "cmake.sourceDirectory": "/workspaces/STAR/e2-studio-star-rx72n-firmware",
  "protobuf.lint.ignore": [
    "e2-studio-star-rx72n-firmware/**"
  ],
  "protobuf.options.ignore": [
    "e2-studio-star-rx72n-firmware/**"
  ],
  "files.associations": {
    "e2-studio-star-rx72n-firmware/libs/rx_nanopb/**/*.proto": "plaintext"
  },
  "files.exclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "search.exclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "files.watcherExclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "problems.exclude": {
    "**/e2-studio-star-rx72n-firmware/libs/rx_nanopb/nanopb/**": true
  },
  "protobuf.buf.path": "/usr/local/bin/buf",
  "protobuf.protoc.path": "/usr/bin/protoc"
}
