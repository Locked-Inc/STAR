#!/usr/bin/env bash
# Pre-commit hook to match CI/CD pipelines
# Checks Go (fmt/lint), C++ (clang-format/cpplint), Proto (buf)

set -uo pipefail

# Allow skipping checks
if [[ "${1:-}" == "--no-verify" ]]; then
    exit 0
fi

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# Flags to track errors
error_found=0

echo "🔍 Running pre-commit checks..."

# -----------------------------------------------------------------------------
# GO CHECKS
# -----------------------------------------------------------------------------
go_files=$(echo "$staged_files" | grep "\.go$" || true)
if [[ -n "$go_files" ]]; then
    echo "🐹 Checking Go files..."
    
    # Check formatting
    unformatted=$(gofmt -l $go_files)
    if [[ -n "$unformatted" ]]; then
        echo "❌ Unformatted Go files:"
        echo "$unformatted"
        echo "   Run: gofmt -w $unformatted"
        error_found=1
    fi

    # Run linting (fast mode for speed)
    # We run this on the whole module usually, but let's try to be specific if possible
    # golangci-lint works best on packages.
    pushd star-gateway >/dev/null
    if ! golangci-lint run --fast --timeout=2m ./...; then
        echo "❌ Go linting failed."
        error_found=1
    fi
    popd >/dev/null
fi

# -----------------------------------------------------------------------------
# C++ CHECKS
# -----------------------------------------------------------------------------
cpp_files=$(echo "$staged_files" | grep -E "\.(cpp|hpp|cc|h)$" || true)
if [[ -n "$cpp_files" ]]; then
    echo "🦕 Checking C++ files..."

    # Check clang-format
    for file in $cpp_files; do
        if ! clang-format --dry-run --Werror "$file"; then
            echo "❌ Formatting error in: $file"
            echo "   Run: clang-format -i $file"
            error_found=1
        fi
    done

    # Run cpplint
    if command -v ament_cpplint &> /dev/null; then
        for file in $cpp_files; do
            # Only check files inside star-ros2
            if [[ "$file" == *"star-ros2"* ]]; then
                 if ! ament_cpplint "$file" >/dev/null; then
                    echo "❌ cpplint error in: $file"
                    error_found=1
                 fi
            fi
        done
    fi
fi

# -----------------------------------------------------------------------------
# PROTOBUF CHECKS
# -----------------------------------------------------------------------------
proto_files=$(echo "$staged_files" | grep "\.proto$" || true)
if [[ -n "$proto_files" ]]; then
    echo "📦 Checking Protobuf files..."

    # Check formatting
    pushd star-proto >/dev/null
    if ! buf format --diff --exit-code; then
        echo "❌ Protobuf formatting failed."
        echo "   Run: buf format -w"
        error_found=1
    fi

    # Check linting
    if ! buf lint; then
        echo "❌ Protobuf linting failed."
        error_found=1
    fi
    popd >/dev/null
fi

# -----------------------------------------------------------------------------
# CONCLUSION
# -----------------------------------------------------------------------------
if [[ $error_found -ne 0 ]]; then
    echo "⛔ Commit rejected due to linting/formatting errors."
    exit 1
fi

echo "✅ All checks passed."
exit 0