#!/usr/bin/env bash
# Pre-commit hook to match CI/CD pipelines
# Checks Go (fmt/lint), C++ (clang-format/cpplint), Proto (buf)

set -uo pipefail

# Allow skipping checks
if [[ "${1:-}" == "--no-verify" ]]; then
    exit 0
fi

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# Flags to track errors
error_found=0

echo "Running pre-commit checks..."

# -----------------------------------------------------------------------------
# ASCII-ONLY SOURCE CODE CHECK
# -----------------------------------------------------------------------------
ascii_ok=true
while IFS= read -r staged_file; do
    if [[ "$staged_file" =~ \.(c|h|go|cpp|hpp|proto|ts|md)$ ]]; then
        if grep -qP "[^\x00-\x7F]" "$staged_file" 2>/dev/null; then
            echo "ERROR: Non-ASCII characters in staged file: $staged_file"
            grep -nP "[^\x00-\x7F]" "$staged_file" | head -5
            ascii_ok=false
        fi
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ "$ascii_ok" == "false" ]]; then
    echo ""
    echo "STAR policy: All source files must use ASCII-only characters."
    echo "Run: python3 scripts/fix-encoding.py <file> to auto-fix."
    echo "See CLAUDE.md 'Character Encoding Policy' for replacement table."
    exit 1
fi

# -----------------------------------------------------------------------------
# SECRET SCANNING (TruffleHog)
# -----------------------------------------------------------------------------
if command -v trufflehog &>/dev/null; then
    repo_root=$(git rev-parse --show-toplevel)
    if [[ -z "$repo_root" ]]; then
        echo "[FAIL] Could not determine repo root; aborting secret scan."
        exit 1
    fi

    # Skip on initial commit (unborn HEAD) — nothing to scan yet
    if ! git rev-parse --verify HEAD &>/dev/null; then
        echo "SKIP: No HEAD commit yet; skipping secret scan on initial commit."
    else
        # Config file lives in the main working tree, not in worktrees
        main_tree=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')
        if [[ -z "$main_tree" ]]; then
            echo "WARN: Could not determine main worktree; exclusion list will be skipped."
        fi
        exclude_file="${main_tree:+$main_tree/}.trufflehog-exclude-paths.txt"

        echo "Scanning staged changes for secrets..."
        trufflehog_args=(git "file://$repo_root"
            --since-commit HEAD
            --results=verified
            --fail
            --no-update
            --trust-local-git-config)
        if [[ -n "$main_tree" && -f "$exclude_file" ]]; then
            trufflehog_args+=(--exclude-paths "$exclude_file")
        fi
        # Fail-fast: secret findings exit immediately (not accumulated in error_found)
        # because a live credential must be removed before any other checks matter.
        trufflehog "${trufflehog_args[@]}"
        th_exit=$?
        if [[ $th_exit -eq 183 ]]; then
            echo ""
            echo "[FAIL] TruffleHog detected secrets in staged changes."
            echo "   Remove the secret, rotate the credential, then re-commit."
            echo "   Docs: https://github.com/trufflesecurity/trufflehog"
            exit 1
        elif [[ $th_exit -ne 0 ]]; then
            echo ""
            echo "[FAIL] TruffleHog scan error (exit $th_exit). Aborting as a precaution."
            exit 1
        fi
    fi
else
    echo ""
    echo "WARNING: trufflehog is not installed -- secret scanning was SKIPPED."
    echo "   Install: https://github.com/trufflesecurity/trufflehog#installation"
    echo "   CI will still enforce secret scanning via GitHub Actions."
fi

# -----------------------------------------------------------------------------
# GO CHECKS
# -----------------------------------------------------------------------------
go_files=$(echo "$staged_files" | grep "\.go$" || true)
if [[ -n "$go_files" ]]; then
    echo "Checking Go files..."
    
    # Check formatting
    unformatted=$(gofmt -l $go_files)
    if [[ -n "$unformatted" ]]; then
        echo "[FAIL] Unformatted Go files:"
        echo "$unformatted"
        echo "   Run: gofmt -w $unformatted"
        error_found=1
    fi

    # Run linting (fast mode for speed)
    # We run this on the whole module usually, but let's try to be specific if possible
    # golangci-lint works best on packages.
    pushd star-gateway >/dev/null
    if ! golangci-lint run --timeout=2m ./...; then
        echo "[FAIL] Go linting failed."
        error_found=1
    fi
    popd >/dev/null
fi

# -----------------------------------------------------------------------------
# C++ CHECKS
# -----------------------------------------------------------------------------
cpp_files=$(echo "$staged_files" | grep -E "\.(cpp|hpp|cc|h)$" || true)
if [[ -n "$cpp_files" ]]; then
    echo "Checking C++ files..."

    # Use the official format-ros2.sh script in check mode
    # This uses ament_uncrustify and checks header guards
    if ! bash scripts/format-ros2.sh --check --verbose; then
        echo "[FAIL] C++ formatting or header guard check failed."
        echo "   Run: bash scripts/format-ros2.sh"
        error_found=1
    fi
fi

# -----------------------------------------------------------------------------
# RX72N FIRMWARE C CHECKS
# -----------------------------------------------------------------------------
rx72n_files=$(echo "$staged_files" \
  | grep -E "^e2-studio-star-rx72n-firmware/.*\.(c|h)$" \
  | grep -vE "/(libs/threadx|libs/rx_nanopb/nanopb|libs/rx_nanopb/inc/gen|src/boot/smc_generated|src/boot/r_bsp|src/boot/inc/smc_generated)/" \
  || true)

if [[ -n "$rx72n_files" ]]; then
    echo "Checking RX72N firmware C/H files..."

    if command -v clang-format &>/dev/null; then
        if ! bash e2-studio-star-rx72n-firmware/scripts/format_code.sh --check; then
            echo "[FAIL] RX72N firmware formatting failed."
            echo "   Run: make format-rx72n"
            error_found=1
        fi
    else
        echo ""
        echo "WARNING: clang-format not found -- RX72N formatting check SKIPPED."
        echo "   Install: sudo apt install clang-format"
    fi
fi

# -----------------------------------------------------------------------------
# PROTOBUF CHECKS
# -----------------------------------------------------------------------------
proto_files=$(echo "$staged_files" | grep "\.proto$" || true)
if [[ -n "$proto_files" ]]; then
    echo "Checking Protobuf files..."

    # Check formatting
    pushd star-proto >/dev/null
    if ! buf format --diff --exit-code; then
        echo "[FAIL] Protobuf formatting failed."
        echo "   Run: buf format -w"
        error_found=1
    fi

    # Check linting
    if ! buf lint; then
        echo "[FAIL] Protobuf linting failed."
        error_found=1
    fi
    popd >/dev/null
fi

# -----------------------------------------------------------------------------
# CONCLUSION
# -----------------------------------------------------------------------------
if [[ $error_found -ne 0 ]]; then
    echo "[FAIL] Commit rejected due to linting/formatting errors."
    exit 1
fi

echo "[PASS] All checks passed."
exit 0