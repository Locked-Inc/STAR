config BR2_PACKAGE_CYCLONEDDS
	bool "cyclonedds"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Eclipse Cyclone DDS is a very performant and robust
	  open-source DDS implementation.

	  https://github.com/eclipse-cyclonedds/cyclonedds

comment "cyclonedds needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
