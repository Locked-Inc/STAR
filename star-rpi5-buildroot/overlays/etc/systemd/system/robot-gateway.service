[Unit]
Description=STAR Robot Gateway Service
Documentation=https://github.com/Locked-Inc/STAR
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/robot-gateway
ExecStart=/usr/bin/star-gateway
Restart=always
RestartSec=10

# Environment variables
Environment="ROS_DISTRO=jazzy"
Environment="ROS_VERSION=2"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-gateway

# Security (optional, can be adjusted)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
