# QEMU virtio support for testing on generic ARM64 'virt' machine
# Enables booting with virtio block devices (/dev/vda) and networking

# PCI support (required for virtio-pci)
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# Virtio block device (for root filesystem)
CONFIG_VIRTIO_BLK=y

# Virtio network (for SSH access during testing)
CONFIG_VIRTIO_NET=y

# Virtio transport drivers
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
