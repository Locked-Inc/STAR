	(text "V_OC = (R_OCSET * 2 * I_OCSET_min) + V_OCLOS_min\nV_OC = (7.68 kΩ * 2 * 9.5 µA) + (-8 mV)\nV_OC = 137.9 mV\n\nI_valley = V_OC / R_DS(on)\nI_valley = 137.9 mV / 7.8 mΩ\nI_valley = 17.68 A\n\nI_SCP = I_valley + (I_RIPPLE / 2)\nI_SCP = 17.68 A + (5.95 A / 2)\nI_SCP = 20.66 A"
		(exclude_from_sim no)
		(at 224.282 181.864 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2702c293-89fe-46bf-ab63-0a131b9593f3")
	)
	(text "6V 20A"
		(exclude_from_sim no)
		(at 209.042 122.174 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "71384c74-ba26-4f73-a1ab-363f4eeb7bdc")
	)
	(text "6V/20A\nL=440nH\nf=1.2MHz\nVin=[9.6,12.6]\n\nD = Vout/Vin = 6/12.6 = 0.476 ; use for worst-case input ripple\nI_Ripple = (Vout(1 - Vout/Vin))/(L*f) ; use larger Vin\nI_In = Iout * (Vout/Vin) ; use smaller Vin for max current\nIc(RMS,in) = Iout * SQRT[D*(1-D)]\nIc(RMS,out) = I_Ripple / (2*sqrt(3))\n\nI_Ripple = 5.95A\nI_In = 12.5A\nIc(RMS,in) = 9.99A -> 12A\nIc(RMS,out) = 1.72A -> 2.1A\n\n1, Input cap bank > 12A rms ripple current\n2, Output cap bank > 2.1A rms ripple current\n\n3, Ripple_Vout = I_Ripple * ESR\n60mA = 5.95A * ESR, ESR=10.1mOhm\n\n4, 12.5A is the max average current drawn from the source\n"
		(exclude_from_sim no)
		(at 174.752 93.218 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ff96f8cc-a02c-46ba-a4ed-ab7a81fcd54d")
	)
