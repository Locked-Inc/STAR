	(text " \"Please note that the VDD_SPI voltage is 1.8 V for ESP32-S3-WROOM-1-N16R16VA and ESP32-S3-WROOM-1U-N16R16VA only\"\n IO47 and IO48: These pins operate at 1.8 V if the module is embedded with the ESP32-S3R16V chip."
		(exclude_from_sim no)
		(at 266.446 142.748 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4079b9a5-b9a1-462e-9df4-a996e1a82094")
	)
	(text "ESP32-S3-WROOM-1-N16\n\nThis does not end with R_\nso this does not have PSRAM\nwe are allowed to use IO35-IO37\nfor SPI2"
