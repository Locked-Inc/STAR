# esp32-firmware/main/Kconfig.projbuild

menu "PYNQ WiFi Bridge Configuration"

    choice PYNQ_BOARD_TYPE
        prompt "Board Type"
        default PYNQ_BOARD_ESP32_WROOM_32
        help
            Select the ESP32 board type for pin defaults and optimizations.
            This automatically configures the correct partition table:
            - ESP32-WROOM-32: 4MB flash, 900KB OTA partitions
            - ESP32-S3-WROOM-1-N16: 16MB flash, 2MB OTA partitions + 8MB SPIFFS

        config PYNQ_BOARD_ESP32_WROOM_32
            bool "ESP32-WROOM-32 (4MB flash)"
            help
                Current development board (ESP32-WROOM-32)
                - 4 MB flash
                - OTA partitions: 900 KB each
                - Suitable for testing and development

        config PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            bool "ESP32-S3-WROOM-1-N16 (16MB flash)"
            help
                Future production board (ESP32-S3-WROOM-1-N16)
                - 16 MB flash + 8 MB PSRAM
                - OTA partitions: 2 MB each
                - SPIFFS: 8 MB for logs/data
                - Coredump: 64 KB for debugging
    endchoice

    config PYNQ_CUSTOM_PARTITION_TABLE_PATH
        string
        default "partitions_ota_4mb.csv" if PYNQ_BOARD_ESP32_WROOM_32
        default "partitions_ota_16mb.csv" if PYNQ_BOARD_ESP32_S3_WROOM_1_N16

    choice PYNQ_TRANSPORT_MODE
        prompt "Transport Mode"
        default PYNQ_TRANSPORT_UART
        help
            Select communication method with PYNQ-Z2.
            UART: For testing and development
            SPI: For production use (ESP32 as SPI slave)

        config PYNQ_TRANSPORT_UART
            bool "UART"
            help
                Use UART for communication (testing/development)

        config PYNQ_TRANSPORT_SPI
            bool "SPI Slave"
            help
                Use SPI slave mode for communication (production)
    endchoice

    menu "UART Configuration"
        depends on PYNQ_TRANSPORT_UART

        config PYNQ_UART_TX_GPIO
            int "UART TX GPIO"
            default 17 if PYNQ_BOARD_ESP32_WROOM_32
            default 43 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            range 0 39 if PYNQ_BOARD_ESP32_WROOM_32
            range 0 48 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            help
                GPIO pin for UART TX (transmit to PYNQ-Z2)
                ESP32-WROOM-32: GPIO17
                ESP32-S3-WROOM-1-N16: GPIO43 (TXD0)

        config PYNQ_UART_RX_GPIO
            int "UART RX GPIO"
            default 16 if PYNQ_BOARD_ESP32_WROOM_32
            default 44 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            range 0 39 if PYNQ_BOARD_ESP32_WROOM_32
            range 0 48 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            help
                GPIO pin for UART RX (receive from PYNQ-Z2)
                ESP32-WROOM-32: GPIO16
                ESP32-S3-WROOM-1-N16: GPIO44 (RXD0)

        config PYNQ_UART_BAUD_RATE
            int "UART Baud Rate"
            default 115200
            help
                UART baud rate for communication

    endmenu

    menu "SPI Configuration"
        depends on PYNQ_TRANSPORT_SPI

        config PYNQ_SPI_MOSI_GPIO
            int "SPI MOSI GPIO"
            default 13 if PYNQ_BOARD_ESP32_WROOM_32
            default 11 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            range 0 39 if PYNQ_BOARD_ESP32_WROOM_32
            range 0 48 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            help
                GPIO pin for SPI MOSI (Master Out Slave In - PYNQ to ESP32)
                ESP32-WROOM-32: GPIO13
                ESP32-S3-WROOM-1-N16: IO11

        config PYNQ_SPI_MISO_GPIO
            int "SPI MISO GPIO"
            default 12 if PYNQ_BOARD_ESP32_WROOM_32
            default 13 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            range 0 39 if PYNQ_BOARD_ESP32_WROOM_32
            range 0 48 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            help
                GPIO pin for SPI MISO (Master In Slave Out - ESP32 to PYNQ)
                ESP32-WROOM-32: GPIO12
                ESP32-S3-WROOM-1-N16: IO13

        config PYNQ_SPI_CLK_GPIO
            int "SPI CLK GPIO"
            default 14 if PYNQ_BOARD_ESP32_WROOM_32
            default 12 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            range 0 39 if PYNQ_BOARD_ESP32_WROOM_32
            range 0 48 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            help
                GPIO pin for SPI CLK (Clock from PYNQ)
                ESP32-WROOM-32: GPIO14
                ESP32-S3-WROOM-1-N16: IO12 (SCLK)

        config PYNQ_SPI_CS_GPIO
            int "SPI CS GPIO"
            default 15 if PYNQ_BOARD_ESP32_WROOM_32
            default 10 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            range 0 39 if PYNQ_BOARD_ESP32_WROOM_32
            range 0 48 if PYNQ_BOARD_ESP32_S3_WROOM_1_N16
            help
                GPIO pin for SPI CS (Chip Select from PYNQ)
                ESP32-WROOM-32: GPIO15
                ESP32-S3-WROOM-1-N16: IO10 (CS)

        config PYNQ_SPI_CLOCK_SPEED_HZ
            int "SPI Clock Speed (Hz)"
            default 1000000
            range 100000 10000000
            help
                SPI clock frequency in Hz (max 10MHz for reliable operation)

    endmenu

    menu "WiFi Configuration"

        config PYNQ_WIFI_SSID
            string "WiFi SSID"
            default "myssid"
            help
                WiFi network name (SSID) to connect to

        config PYNQ_WIFI_PASSWORD
            string "WiFi Password"
            default "mypassword"
            help
                WiFi network password

        config PYNQ_WIFI_MAXIMUM_RETRY
            int "Maximum WiFi Retry Attempts"
            default 5
            help
                Maximum number of retry attempts when connecting to WiFi

    endmenu

    menu "OTA Update Configuration"

        config PYNQ_OTA_UPDATE_URL
            string "OTA Update URL"
            default "https://robot-backend.com/api/esp32/firmware.bin"
            help
                URL to download firmware updates from.
                This should point to your backend server's firmware endpoint.
                Example: https://robot-backend.com/api/esp32/firmware.bin

        config PYNQ_OTA_VERSION_CHECK_URL
            string "OTA Version Check URL"
            default "https://robot-backend.com/api/esp32/version"
            help
                URL to check for firmware version information.
                Server should return JSON with: version, url, min_version, changelog
                Example: https://robot-backend.com/api/esp32/version

        config PYNQ_OTA_AUTO_UPDATE
            bool "Enable Automatic OTA Updates"
            default n
            help
                If enabled, ESP32 will automatically check for and install updates.
                If disabled (default), updates must be triggered manually via PYNQ.

        config PYNQ_OTA_CHECK_INTERVAL_MS
            int "OTA Update Check Interval (milliseconds)"
            default 3600000
            range 60000 86400000
            depends on PYNQ_OTA_AUTO_UPDATE
            help
                How often to check for firmware updates (in milliseconds).
                Default: 3600000 (1 hour)
                Min: 60000 (1 minute)
                Max: 86400000 (24 hours)

        config PYNQ_OTA_AUTO_REBOOT
            bool "Automatically Reboot After Update"
            default y
            help
                If enabled, ESP32 will automatically reboot after a successful update.
                If disabled, reboot must be triggered manually.

        config PYNQ_OTA_HTTPS_CERT_VERIFICATION
            bool "Enable HTTPS Certificate Verification"
            default n
            help
                If enabled, OTA downloads will verify the server's TLS certificate.
                Requires a valid CA certificate to be embedded in the firmware.
                Disable for testing with self-signed certificates or HTTP servers.

    endmenu

endmenu
