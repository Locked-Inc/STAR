% Command for colored layer boxes
\newcommand{\layerbox}[3]{% #1=color, #2=title, #3=content
    \vspace{0.15cm}
    \noindent\colorbox{#1}{%
        \parbox{\dimexpr\linewidth-2\fboxsep}{%
            \textbf{#2}\\[0.1cm]
            #3
        }%
    }
    \vspace{0.15cm}
}

