% RAM Heat Map colors
\definecolor{ramlow}{HTML}{FFFFFF}           % White - low workload
\definecolor{ramhigh}{HTML}{1565C0}          % Dark blue - high workload

% Dynamic heat map cell: \ramcell{value}{maxvalue}
% Usage: \ramcell{12}{20} produces colored cell with value 12
\newcommand{\ramcell}[2]{%
    \pgfmathsetmacro{\intensity}{min(100, (#1/#2)*100)}%
    \edef\temp{\noexpand\cellcolor{ramhigh!\intensity!ramlow}}%
    \temp%
    \ifnum#1>0 #1\else --\fi%
}

% Cell with primary + secondary: \ramcellboth{primary}{secondary}{max}
% Usage: \ramcellboth{10}{3}{20} shows "10 +3" with color based on primary
\newcommand{\ramcellboth}[3]{%
    \pgfmathsetmacro{\intensity}{min(100, (#1/#3)*100)}%
    \edef\temp{\noexpand\cellcolor{ramhigh!\intensity!ramlow}}%
    \temp%
    \textbf{#1}\ifnum#2>0 {\tiny\textcolor{gray}{+#2}}\fi%
}

