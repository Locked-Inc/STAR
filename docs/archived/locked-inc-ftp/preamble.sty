% --- HEADER SAFE MARKERS (Use these inside \section, \caption, etc.) ---
% These use \colorbox instead of \texthl because \texthl breaks inside headers.

\newcommand{\HFIXME}[1]{%
    \texorpdfstring%
    {\protect\colorbox{fixmebg}{\protect\textcolor{fixmecolor}{\textbf{[FIXME: #1]}}}}% Content in Doc
    {[FIXME: #1]}% Content in PDF Bookmarks
}

