    {[TODO: #1]}%
}

\newcommand{\HPLACEHOLDER}[1]{%
    \texorpdfstring%
    {\protect\colorbox{placeholderbg}{\protect\textcolor{placeholdercolor}{\textbf{[#1]}}}}%
    {[#1]}%
}

\newcommand{\HVERIFY}[1]{%
