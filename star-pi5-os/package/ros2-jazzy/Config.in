config BR2_PACKAGE_ROS2_JAZZY
	bool "ros2-jazzy"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9
	select BR2_PACKAGE_PYTHON3_PY_PYC
	select BR2_PACKAGE_PYTHON3_PIP
	select BR2_PACKAGE_PYTHON3_SETUPTOOLS
	select BR2_PACKAGE_PYTHON_NUMPY
	select BR2_PACKAGE_EIGEN
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_YAML_CPP
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_LTTNG_LIBUST
	select BR2_PACKAGE_LTTNG_TOOLS
	help
	  ROS2 Jazzy (Robot Operating System 2) - Latest LTS release
	  Pre-built binaries for ARM64 architecture.

	  https://docs.ros.org/en/jazzy/

comment "ros2-jazzy needs Python3 and a toolchain w/ gcc >= 9"
	depends on !BR2_PACKAGE_PYTHON3 || !BR2_TOOLCHAIN_GCC_AT_LEAST_9
