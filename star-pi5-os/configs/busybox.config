# Minimal BusyBox configuration
# Use 'make busybox-menuconfig' in buildroot to customize

CONFIG_DESKTOP=n
CONFIG_EXTRA_COMPAT=n
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_FEATURE_BUFFERS_GO_ON_STACK=n
CONFIG_FEATURE_BUFFERS_GO_IN_BSS=n
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=n
CONFIG_FEATURE_COMPRESS_USAGE=n
CONFIG_LFS=y
CONFIG_PAM=n
CONFIG_FEATURE_DEVPTS=y
CONFIG_FEATURE_UTMP=y
CONFIG_FEATURE_WTMP=y

# Essential networking
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_WGET=y

# Essential file operations
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_LS=y
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y

# Essential system
CONFIG_INIT=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
