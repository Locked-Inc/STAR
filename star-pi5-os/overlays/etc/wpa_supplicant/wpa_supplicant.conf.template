# STAR Robot WiFi Configuration Template
# Copy this file to wpa_supplicant.conf and edit with your WiFi credentials
# Then run: wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf

ctrl_interface=/var/run/wpa_supplicant
ctrl_interface_group=0
update_config=1
country=US

