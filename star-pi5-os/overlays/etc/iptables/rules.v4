# STAR Robot NAT/Firewall Rules
# Enables ESP32 devices on AP network (192.168.4.0/24) to access internet
# via the station interface (wlan0)

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
# NAT: Masquerade traffic from AP network going out via wlan0
-A POSTROUTING -s 192.168.4.0/24 -o wlan0 -j MASQUERADE
COMMIT

*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
# Allow forwarding from AP interface to station interface
-A FORWARD -i uap0 -o wlan0 -j ACCEPT
# Allow established/related connections back from internet
-A FORWARD -i wlan0 -o uap0 -m state --state RELATED,ESTABLISHED -j ACCEPT
COMMIT
