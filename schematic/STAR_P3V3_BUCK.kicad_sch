	(text "2A\nFsw=1.5MHz\nL=1uH"
		(exclude_from_sim no)
		(at 138.43 120.904 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b27541b6-d104-4e5a-83c1-84ac912591e1")
	)
	(text "3.3V/2A\nFsw=1.5MHz\nL=1uH\nIc(RMS1) = 0.66A\n\nD = Vout/Vin = 3.3/5 = 0.66\nI_Ripple = (Vout(1 - Vout/Vin))/(L*f)\nI_In = Iout * (Vout/Vin)\nIc(RMS) = Iout * SQRT[(Vout/Vin)(1-(Vout/Vin))]\nIc(RMS)tot = SQRT[Ic(RMS1)^2 + Ic(RMS2)^2]\n\nI_Ripple = 0.748A\nI_In = 1.32A\nIc(RMS2) = 0.947A\nIc(RMS)tot = 1.155A -> 1.4A\n\n1, find cap bank > 1.4A rms ripple current\n\n2, Ripple_Vout = I_Ripple * ESR\n33mA = 0.748A * ESR, ESR=44.1mOhm\n\n3, 1.32A is drawn from the previous 5V stage"
		(exclude_from_sim no)
		(at 115.316 54.864 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f7dea111-b670-4aee-9d9e-073313df465a")
	)
