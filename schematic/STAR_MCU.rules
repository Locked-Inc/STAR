
(rules PCB STAR_MCU.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 4.5)
    )
    (layer_rule In1.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.3)
    )
    (layer_rule In2.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.7)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 4.1)
    )
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
    (clearance 200.0 (type "3V3 Main Rail,Default"))
    (clearance 200.0 (type "Motor PWM Control,Default"))
    (clearance 200.0 (type "SMBus BMS,Default"))
    (clearance 200.0 (type "6V0 Buck,Default"))
    (clearance 200.0 (type Encoders,Default))
    (clearance 200.0 (type "System Config,Default"))
    (clearance 200.0 (type Debug/Programming,Default))
    (clearance 200.0 (type "Motor VCC,Default"))
    (clearance 200.0 (type "Motor Driver SPI Config,Default"))
    (clearance 200.0 (type "Motor Fault Signals,Default"))
    (clearance 200.0 (type "Host SPI,Default"))
    (clearance 200.0 (type "IMU Control,Default"))
    (clearance 200.0 (type LED,Default))
    (clearance 200.0 (type "LiDAR UART,Default"))
    (clearance 200.0 (type "Motor Current Sensing,Default"))
    (clearance 200.0 (type "Motor VEE,Default"))
    (clearance 200.0 (type "3V3 Buck,Default"))
    (clearance 200.0 (type "5V0 Buck,Default"))
    (clearance 200.0 (type "USB SCI Data,Default"))
    (clearance 200.0 (type "SONAR ECHO,Default"))
    (clearance 200.0 (type "SONAR TRIG,Default"))
    (clearance 200.0 (type "Temperature Sensor,Default"))
    (clearance 200.0 (type Ground,Power/Ground,Default))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
