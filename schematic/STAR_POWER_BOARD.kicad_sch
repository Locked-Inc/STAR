		(uuid "005b2e9c-8641-4570-8313-a8990064e6e4")
	)
	(text "For a triangular wave from the inductor, \nthe formula is Ic(RMS) = I_Ripple / (2*sqrt(3)).\nIc(RMS,out) = 2.285A / 3.464 = 0.66A -> 0.8A"
		(exclude_from_sim no)
		(at 440.944 218.948 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0e88a7cf-f16d-422c-bba1-abf6813f6ebb")
	)
	(text "Might need to double the fets, that is what we bench says\n"
		(exclude_from_sim no)
		(at 518.16 315.976 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "131b141c-1e57-4dae-935b-f73c7bee1b44")
	)
	(text "V_OC = (R_OCSET * 2 * I_OCSET_min) + V_OCLOS_min\nV_OC = (7.68 kΩ * 2 * 9.5 µA) + (-8 mV)\nV_OC = 137.9 mV\n\nI_valley = V_OC / R_DS(on)\nI_valley = 137.9 mV / 7.8 mΩ\nI_valley = 17.68 A\n\nI_SCP = I_valley + (I_RIPPLE / 2)\nI_SCP = 17.68 A + (5.95 A / 2)\nI_SCP = 20.66 A"
		(exclude_from_sim no)
		(at 370.332 459.486 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "16481346-13e8-429d-94cc-28c57685cf95")
	)
	(text "Connect FB, COMP and SS, to island gnd"
		(exclude_from_sim no)
		(at 437.642 304.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "185fabbe-b440-4e2f-96d7-341e4ea479bc")
	)
	(text "5V/5A\nFsw=600kHz\nL=2u2H"
		(exclude_from_sim no)
		(at 403.098 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "30bf941d-e4a6-42bd-8c26-6e9a4d238193")
	)
	(text "inductor = (vinmax -vout)/(.3*Iout) * (Vout/Vinmax) * (1/Fsw)"
