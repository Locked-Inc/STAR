	(text "For Voltage:\n\nR5= (.6V * R4) / (6 - .6V)"
		(exclude_from_sim no)
		(at 518.16 299.974 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "96f031cd-52d4-4260-bbd1-c2f5e9d49b41")
	)
	(text "ROCSET = ( (IOUT_max - (IP_P / 2)) * RDS_on - VOCLOS ) / ( 2 * IOCSET )\nIout max target current\nIP induct ripple current\nrds on res low side mosfet\nvoclos offset voltage = -8mv\niocset internal current = 9.5microamps"
		(exclude_from_sim no)
		(at 319.024 307.594 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b5f283a6-e1fd-4845-9d0f-5476b7f6f962")
	)
	(text "5V Buck"
		(exclude_from_sim no)
		(at 389.636 197.358 0)
		(effects
			(font
				(size 6.35 6.35)
				(thickness 1.27)
				(bold yes)
			)
		)
		(uuid "d04c08e2-6a30-4f9a-88fe-31c9637ddad7")
	)
	(text "6V/20A\nL=440nH\nf=1.2MHz\nVin=[9.6,12.6]\n\nD = Vout/Vin = 6/12.6 = 0.476 ; use for worst-case input ripple\nI_Ripple = (Vout(1 - Vout/Vin))/(L*f) ; use larger Vin\nI_In = Iout * (Vout/Vin) ; use smaller Vin for max current\nIc(RMS,in) = Iout * SQRT[D*(1-D)]\nIc(RMS,out) = I_Ripple / (2*sqrt(3))\n\nI_Ripple = 5.95A\nI_In = 12.5A\nIc(RMS,in) = 9.99A -> 12A\nIc(RMS,out) = 1.72A -> 2.1A\n\n1, Input cap bank > 12A rms ripple current\n2, Output cap bank > 2.1A rms ripple current\n\n3, Ripple_Vout = I_Ripple * ESR\n60mA = 5.95A * ESR, ESR=10.1mOhm\n\n4, 12.5A is the max average current drawn from the source\n"
		(exclude_from_sim no)
		(at 291.084 456.184 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d3fab85d-bb58-4fd9-88d7-5e92cbdb1f48")
	)
	(text "3.3V Buck"
		(exclude_from_sim no)
		(at 389.636 44.958 0)
		(effects
			(font
				(size 6.35 6.35)
				(thickness 1.27)
				(bold yes)
			)
		)
		(uuid "db65eba3-8e75-4ae2-a733-b0bd276689b2")
	)
	(text "5V/5A\nFsw=600kHz\nL=2u2H\nIc(RMS1) = 2A\n\nD = Vout/Vin = 5/12.6 = 0.397\nD = Vout/Vin = 5/9.6 = 0.521\nUsing 9.6V since its closer to 50% duty\n\nI_Ripple = (Vout(1 - Vout/Vin))/(L*f) ; use larger Vin\nI_In = Iout * (Vout/Vin)\nIc(RMS) = Iout * SQRT[(Vout/Vin)(1-(Vout/Vin))]\nIc(RMS)tot = SQRT[Ic(RMS1)^2 + Ic(RMS2)^2]\n\nI_Ripple = 2.285A\nI_In = 2.6A\nIc(RMS2) = 2.497A\nIc(RMS)tot = 3.2A -> 3.8A\n\n1, find cap bank > 3.8A rms ripple current\n\n2, Ripple_Vout = I_Ripple * ESR\n50mA = 2.285 * ESR, ESR=21.88mOhm\n\n3, 2.6A is drawn from the previous stage"
		(exclude_from_sim no)
		(at 321.31 177.546 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f2bfc191-b05b-441a-8f28-0e0f310ca934")
	)
